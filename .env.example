# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Gitufy GitHub auth (PRD v2.0) --------------------------------------------
# PUBLIC client id of the Gitufy GitHub App (owner @mdtt63729-ui).
# Safe to expose; the device flow needs no secret. Defaults are also baked into
# src/auth/config.ts, so leaving this blank is fine.
VITE_GITHUB_CLIENT_ID="Iv23liLESLFaJa3yzCdE"
VITE_GITHUB_APP_ID="5182766"

# "github-app" or "oauth-app". Auto-detected from the client id prefix (Iv… =>
# github-app) when left blank.
# VITE_GITHUB_CLIENT_TYPE=""

# Optional: ONLY for the experimental Web + PKCE flow. Set this as a CI SECRET;
# never commit it. The primary Device Flow does not use it.
# VITE_GITHUB_CLIENT_SECRET=""

# Optional: stateless CORS relay base URL for the browser build (docs/oauth-relay-worker.js).
# VITE_OAUTH_RELAY_URL=""

# Feature flags
VITE_ENABLE_WEB_FLOW="false"
VITE_ENABLE_PAT_FALLBACK="true"
