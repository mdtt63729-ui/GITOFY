<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget. Only the view types RemoteViews supports are used,
  and every string is set from the provider so the widget never shows stale text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gitofy_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/gitofy_widget_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/gitofy_widget_label"
            android:textColor="#201A1A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/gitofy_widget_repos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/gitofy_widget_empty"
        android:textColor="#4A3A3D"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gitofy_widget_run"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/gitofy_widget_subtitle"
        android:textColor="#7A6A6D"
        android:textSize="11sp" />
</LinearLayout>
